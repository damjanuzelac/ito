# Local Whisper (default ASR provider). Point at any OpenAI-compatible
# transcription server (e.g. speaches / faster-whisper-server).
# When running via docker compose this is overridden to http://whisper:8000.
LOCAL_WHISPER_BASE_URL=http://localhost:8000
LOCAL_WHISPER_MODEL=Systran/faster-whisper-small

# Optional: Groq cloud. Only needed if you switch the ASR provider to 'groq'
# or use edit mode ("hey ito" commands), which requires an LLM.
# GROQ_API_KEY=your_groq_api_key

# Logging
SHOW_ALL_REQUEST_LOGS=false
